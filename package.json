{
  "name": "liushui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "自进化记忆系统：只追加的记忆流水账（Cloudflare Workers + Turso/libSQL）",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migrate": "node scripts/migrate.ts",
    "fts:rebuild": "node scripts/fts-rebuild.ts",
    "test:worker-integration": "node --test packages/worker/integration/wrangler-local.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@libsql/client": "^0.15.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.20.0",
    "globals": "^15.15.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
